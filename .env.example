# SwasthyaGrid Environment Variables (Template)
# Copy this file to .env in backend/ or root as needed.
# NEVER commit the real .env file or real secrets to Git.

# Database Configuration (Phase 2)
MONGODB_URI=mongodb://localhost:27017/swasthyagrid

# Authentication Configuration (Phase 3)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:5000/api

# AI Service Configuration (Phase 8/10)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-pro
